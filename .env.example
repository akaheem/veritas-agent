# ============================================================
# VERITAS — copy to .env and fill in. NEVER commit .env.
# ============================================================

# --- Alpaca (paper trading keys) ---
# Create at https://app.alpaca.markets  →  Paper Trading  →  API Keys
ALPACA_API_KEY=your_paper_key_id
ALPACA_API_SECRET=your_paper_secret_key
# Base URLs are fixed to PAPER endpoints in config; do not point at live trading.

# --- LLM (trade decision core) ---
ANTHROPIC_API_KEY=your_anthropic_key

# --- Runtime ---
# TZ-aware market clock: agent uses America/New_York internally
VERITAS_LOG_LEVEL=INFO
VERITAS_DATA_DIR=./data
